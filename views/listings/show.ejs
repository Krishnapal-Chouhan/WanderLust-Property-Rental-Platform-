<% layout("/layouts/boilerplate") %>

<div class="show-page-container">

    <!-- ===== HERO SECTION ===== -->
    <div class="listing-hero-card">

        <img
            src="<%= list.image.url || 'https://images.pexels.com/photos/29511872/pexels-photo-29511872.jpeg' %>"
            class="listing-hero-img"
            alt="listing-image"
        >

        <div class="listing-hero-body">

            <div class="listing-meta">
                <p class="listing-host">
                    Hosted by
                    <span>
                        <%= list.owner ? list.owner.username : "WanderLust Bot" %>
                    </span>
                </p>
            </div>

            <h1 class="listing-title">
                <%= list.title %>
            </h1>

            <p class="listing-description">
                <%= list.description %>
            </p>

        </div>

        <ul class="listing-info-list">

            <li class="listing-info-item price">
                <span class="price-value">
                    ₹<%= list.price?.toLocaleString("en-IN") || "N/A" %>
                </span>
                <span class="price-label">/ night</span>
            </li>

            <li class="listing-info-item">
                📍 <strong><%= list.location %></strong>
            </li>

            <li class="listing-info-item">
                🌍 <strong><%= list.country %></strong>
            </li>

        </ul>

        <% if(currUser && list.owner && list.owner._id.equals(currUser._id)){ %>

        <div class="listing-actions">

            <a href="/listings/<%= list._id %>/edit" class="btn btn-outline-primary action-btn">
                Edit Listing
            </a>

            <form method="POST"
                  action="/listings/<%= list._id %>?_method=DELETE"
                  onsubmit="return confirm('Delete this listing?');">

                <button class="btn btn-danger action-btn">
                    Delete Listing
                </button>

            </form>

        </div>

        <% } %>

    </div>


    <!-- ===== REVIEW SECTION ===== -->
    <div class="review-card">

        <% if(currUser){ %>

        <h2 class="section-title">Leave a Review</h2>

        <form action="/listings/<%= list._id %>/reviews"
              method="POST"
              class="review-form">

            <div class="form-group">

                <label>Rating</label>

                <input type="range"
                       min="1"
                       max="5"
                       name="review[rating]"
                       class="rating-slider">

                <div class="rating-labels">
                    <span>1 ⭐</span>
                    <span>2 ⭐</span>
                    <span>3 ⭐</span>
                    <span>4 ⭐</span>
                    <span>5 ⭐</span>
                </div>

            </div>

            <div class="form-group">

                <label>Comment</label>

                <textarea name="review[comment]"
                          rows="4"
                          class="review-input"
                          placeholder="Share your experience..."
                          required></textarea>

            </div>

            <button class="btn btn-primary submit-review-btn">
                Submit Review
            </button>

        </form>

        <hr class="divider">

        <% } %>


        <% if(list.reviews.length > 0){ %>
            <h3 class="section-title">
                Reviews (<%= list.reviews.length %>)
            </h3>
        <% } %>


        <% for(let review of list.reviews){ %>

        <div class="review-item">

            <div class="review-header">

                <div class="review-avatar">
                    <div class="avatar-circle">
                        <%= review.author ? review.author.username.charAt(0).toUpperCase() : "G" %>
                    </div>
                </div>

                <div class="review-user-info">

                    <h5>
                        <%= review.author ? review.author.username : "Guest User" %>
                    </h5>

                    <small>
                        <%= new Date(review.createdAt).toLocaleString("en-IN", {
                            timeZone: "Asia/Kolkata"
                        }) %>
                    </small>

                </div>

            </div>

            <div class="review-rating">
                <% for(let i = 0; i < review.rating; i++){ %>
                    ⭐
                <% } %>
            </div>

            <p class="review-text">
                <%= review.comment %>
            </p>

            <% if(currUser && ((list.owner && list.owner._id.equals(currUser._id)) ||
                (review.author && review.author._id.equals(currUser._id)))){ %>

                <form action="/listings/<%= list._id %>/reviews/<%= review._id %>?_method=DELETE"
                      method="POST">

                    <button class="btn btn-outline-danger btn-sm delete-review-btn">
                        Delete Review
                    </button>

                </form>

            <% } %>

        </div>

        <% } %>

    </div>


    <!-- ===== MAP SECTION ===== -->
    <div class="map-card">

        <h2 class="section-title">📍 Where you'll be</h2>

        <p class="map-location-text">
            <%= list.location %>, <%= list.country %>
        </p>

        <% if(list.geometry && list.geometry.coordinates && list.geometry.coordinates.length === 2){ %>

            <div id="map"
                 class="map-box"
                 data-lat="<%= list.geometry.coordinates[1] %>"
                 data-lng="<%= list.geometry.coordinates[0] %>"
                 data-title="<%= list.title %>">
            </div>

        <% } else { %>

            <div class="map-warning">
                Location coordinates are not available for this listing.
            </div>

        <% } %>

    </div>

</div>